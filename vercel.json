{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/docs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "DEPLOYMENT_TARGET=vercel npm run build",
  "outputDirectory": "build"
}